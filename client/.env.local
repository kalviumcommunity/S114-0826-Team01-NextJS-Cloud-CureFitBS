# Vite Environment Variables for CureFit Client
# Note: All VITE_ prefixed variables are exposed to the browser

# API Configuration
VITE_API_BASE=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000

# Production Override Example:
# VITE_API_BASE=https://curefit-api.render.com/api
# VITE_WS_URL=wss://curefit-api.render.com
